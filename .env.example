# This file is documentation; export values in your process/WSGI environment.
# Never upload a real .env or credentials in a release ZIP.
SOLACE_ENV=production
SOLACE_PUBLIC_URL=https://watch.example.com
SOLACE_SITE_NAME=Solace
SOLACE_CONTACT_EMAIL=support@example.com
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
COOKIE_SECURE=1
HOST=127.0.0.1
PORT=8080
# Optional absolute persistent directory; leave unset to preserve the current instance/.
SOLACE_INSTANCE_PATH=
# Only enable behind one trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=0
SOLACE_TRUST_X_REAL_IP=0
SOLACE_LOG_REQUESTS=1
# Readiness requires email unless a limited launch explicitly opts out.
SOLACE_REQUIRE_EMAIL=1
SOLACE_SMTP_HOST=
SOLACE_SMTP_PORT=587
SOLACE_SMTP_SSL=0
SOLACE_SMTP_USERNAME=
SOLACE_SMTP_PASSWORD=
SOLACE_MAIL_FROM=
# Keep the existing server key/admin password file if already configured.
YOUTUBE_API_KEY=
SOLACE_ADMIN_PASSWORD_HASH=

# Optional native build variable: public backend URL only, never a secret.
# EXPO_PUBLIC_API_URL=https://watch.example.com

# Named staff are enrolled locally using setup_staff.py; no default credentials.
# Discovery consent is off by default. Safety switches and storage controls persist in the admin dashboard.
